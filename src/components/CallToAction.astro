---
/**
 * CallToAction Component
 * A prominent CTA section for conversions
 * Demonstrates gradient backgrounds and responsive design
 */
interface Props {
  title: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
}

const { 
  title, 
  description, 
  buttonText = "Get Started", 
  buttonLink = "#" 
} = Astro.props;
---

<section class="cta">
  <div class="cta-content">
    <h2 class="cta-title">{title}</h2>
    {description && <p class="cta-description">{description}</p>}
    <a href={buttonLink} class="cta-button">{buttonText}</a>
  </div>
</section>

<style>
  .cta {
    padding: 4rem 2rem;
    margin: 2rem;
    border-radius: 24px;
    background: linear-gradient(135deg, #f5deb3 0%, #deb887 50%, #d2b48c 100%);
    text-align: center;
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    color: #3d2814;
    margin: 0 0 1rem 0;
  }

  .cta-description {
    font-size: 1.1rem;
    color: #5a3d1a;
    margin: 0 0 2rem 0;
    line-height: 1.6;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    background: #3d2814;
    color: #fff;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(61, 40, 20, 0.3);
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(61, 40, 20, 0.4);
    background: #2a1b0e;
  }

  @media (max-width: 640px) {
    .cta {
      padding: 3rem 1.5rem;
      margin: 1rem;
    }
  }
</style>
