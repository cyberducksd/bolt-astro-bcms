---
/**
 * Navbar Component
 * A responsive navigation bar
 * Demonstrates responsive design patterns
 */
import bunLogo from '../assets/bun-logo.svg';

interface NavLink {
  text: string;
  href: string;
}

interface Props {
  links?: NavLink[];
}

const { 
  links = [
    { text: "Features", href: "#features" },
    { text: "Docs", href: "#" },
    { text: "Blog", href: "#" }
  ] 
} = Astro.props;
---

<nav class="navbar">
  <div class="navbar-content">
    <a href="/" class="navbar-brand">
      <img src={bunLogo.src} alt="Bun Logo" class="navbar-logo" />
      <span class="navbar-title">Bun</span>
    </a>
    
    <div class="navbar-links">
      {links.map((link) => (
        <a href={link.href} class="navbar-link">{link.text}</a>
      ))}
    </div>
    
    <a href="#" class="navbar-cta">Get Started</a>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1rem 2rem;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(210, 180, 140, 0.2);
  }

  .navbar-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .navbar-logo {
    width: 40px;
    height: 40px;
  }

  .navbar-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #1a1a1a;
  }

  .navbar-links {
    display: flex;
    gap: 2rem;
  }

  .navbar-link {
    color: #666;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .navbar-link:hover {
    color: #4a3728;
  }

  .navbar-cta {
    padding: 0.5rem 1.25rem;
    background: linear-gradient(135deg, #f5deb3 0%, #d2b48c 100%);
    color: #4a3728;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .navbar-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(210, 180, 140, 0.4);
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 1rem;
    }
    
    .navbar-links {
      display: none;
    }
  }
</style>
